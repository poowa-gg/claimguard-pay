PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID_FROM_developer.paypal.com
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_SECRET
PAYPAL_ENVIRONMENT=sandbox
# Optional: pin the sandbox accounts used for every approved claim, whatever email the form sends.
# PAYPAL_PAYEE_EMAIL is the sandbox Business account that receives the order.
# PAYPAL_PAYOUT_RECEIVER_EMAIL is the sandbox account that receives the payout (use a different account from the sender).
# PAYPAL_PAYEE_EMAIL=sb-xxxx@business.example.com
# PAYPAL_PAYOUT_RECEIVER_EMAIL=sb-yyyy@personal.example.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_FROM_ai.google.dev
# Optional: override the Gemini model used for decision explanations
# GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_APP_URL=http://localhost:3000
